# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# "mainnet" (Robinhood Chain, chain 4663, real funds, default) or
# "testnet" (Robinhood Chain Testnet, chain 46630).
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
NEXT_PUBLIC_ROBINHOOD_NETWORK=mainnet

# Public site URL, used for Open Graph metadata (e.g. https://sherwood.example).
# When empty, Vercel's deployment URL is used, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sibling deployments for the Mainnet ↔ Testnet switch. Set both values in both
# deployments, e.g. https://sherwood.example and https://testnet.sherwood.example.
# The switch is hidden while the other URL is empty.
NEXT_PUBLIC_MAINNET_URL=
NEXT_PUBLIC_TESTNET_URL=

# ---------------------------------------------------------------------------
# ZKx8004 registry (optional)
# ---------------------------------------------------------------------------
# Pre-deployed registry addresses. `npm run e2e:mainnet` fills in the mainnet one.
NEXT_PUBLIC_REGISTRY_ADDRESS_MAINNET=
NEXT_PUBLIC_REGISTRY_ADDRESS_TESTNET=

# Receives protocol fees (agent deployment, paid capabilities) in live mode.
# Leave empty to disable fees for live wallets.
NEXT_PUBLIC_TREASURY_ADDRESS=

# ---------------------------------------------------------------------------
# x402 facilitator (server only, never exposed to the browser)
# ---------------------------------------------------------------------------
# Relayer key that settles USDG transferWithAuthorization and pays gas.
# `npm run wallets:setup` creates one. Fund it with a little ETH only.
X402_FACILITATOR_PRIVATE_KEY=

# Merchant address that receives x402 payments (defaults to the relayer address).
X402_PAY_TO=

# Price of /api/x402/premium in USDG.
X402_PRICE_USDG=0.01

# ---------------------------------------------------------------------------
# On-chain end-to-end test (scripts only)
# ---------------------------------------------------------------------------
# Hot wallet that pays USDG and registry gas during `npm run e2e:mainnet`.
E2E_PAYER_PRIVATE_KEY=
# App URL used by the x402 HTTP step.
BASE_URL=http://localhost:3000
