{
  "name": "sherwood-website",
  "version": "1.0.0",
  "private": true,
  "description": "Sherwood (powered by ZKx8004) — deploy autonomous private agents with zero-knowledge x402 payments on Robinhood Chain.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/verify-runtime.ts && tsx scripts/verify-x402.ts",
    "test:server": "tsx scripts/verify-x402-server.ts",
    "contracts:compile": "tsx scripts/compile-contracts.ts",
    "chain:check": "tsx scripts/check-chain.ts",
    "chain:receipts": "tsx scripts/verify-receipts.ts",
    "wallets:setup": "tsx scripts/setup-wallets.ts",
    "wallets:new": "tsx scripts/new-wallet.ts",
    "e2e:mainnet": "tsx scripts/e2e-onchain.ts",
    "e2e:testnet": "tsx scripts/e2e-onchain.ts --testnet",
    "vectors": "tsx scripts/generate-vectors.ts",
    "vectors:check": "tsx scripts/generate-vectors.ts --check",
    "contracts:test": "forge test",
    "sdk:test": "cd sdk/python && uv run --extra dev pytest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "solc": "^0.8.37",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
